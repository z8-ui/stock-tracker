!tests/fixtures/s3_0/CAPTURE_RUN.log
/tmp/

# 环境变量（真实密钥只放本地 .env，示例可以入库）
.env
.env.*
!.env.example

# 备份（如果有）
*-backup-*.tar.gz

# 个人本地配置（自选池、关注列表等，不被 fork 者看到）
config_local.py

# 运行时缓存（交易日数据快照，休盘时段恢复）
_data_cache.json

# AI 分析结果缓存（本地文件，避免重复调用 DeepSeek）
ai_cache.json

# 政策事件中心 SQLite 库（本地数据，不入库）
# 注意必须带前导 /：写成 data/ 会连 services/data/ 这种代码包一起忽略掉
/data/

# 每日 feed 日志（同上，只忽略根目录）
/logs/
